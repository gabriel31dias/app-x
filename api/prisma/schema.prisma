generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Postgres (adapter pg em prisma.service.ts). As migrações da época do SQLite estão em prisma/migrations-sqlite.
datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  nome            String
  cpf             String    @unique // só dígitos
  email           String    @unique // minúsculo
  celular         String // só dígitos
  nascimento      DateTime
  senhaHash       String
  avatarUrl       String? // null = foto padrão
  xp              Int       @default(0)
  // sobe no logout/troca de senha: invalida todos os tokens emitidos antes
  tokenVersion    Int       @default(0)
  termosAceitosEm DateTime
  ultimoLoginEm   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// RTP escolhido no painel admin, um por jogo (vale pra todos os jogadores). Sem linha = RTP de fábrica do motor.
model GameRtp {
  jogo          String   @id
  rtp           Float
  atualizadoPor String // e-mail do admin
  atualizadoEm  DateTime @updatedAt
}

// RTP específico por jogador e jogo. Se existir, sobrescreve GameRtp; se não existir, vale o global.
model JogadorRtp {
  email         String
  jogo          String
  rtp           Float
  atualizadoPor String // e-mail do admin
  atualizadoEm  DateTime @updatedAt

  @@id([email, jogo])
  @@index([jogo])
}

// histórico de toda mudança de RTP (nunca é apagado)
model RtpAlteracao {
  id   Int      @id @default(autoincrement())
  jogo String
  de   Float?
  para Float
  por  String
  em   DateTime @default(now())
}

// histórico de mudanças de RTP específico por jogador
model JogadorRtpAlteracao {
  id      Int      @id @default(autoincrement())
  email   String
  jogo    String
  de      Float?
  para    Float?
  por     String
  em      DateTime @default(now())
}

// depósito PIX = "venda" no painel admin. Gravado ao criar o PIX e atualizado a cada consulta de status.
model Deposito {
  id              String    @id // plg-<uuid> Pluggou · orama-<hex> Gatebox · uuid puro BullsCash
  valorCentavos   Int
  liquidoCentavos Int?
  status          String // pendente | pago | falhou
  statusBruto     String // como veio do provedor
  nome            String
  documento       String
  celular         String
  email           String?
  criadoEm        DateTime  @default(now())
  pagoEm          DateTime?
  creditadoEm     DateTime? // já entrou no saldo do jogador (uma vez só, marcado pelo servidor)

  @@index([criadoEm])
  @@index([email])
}

// rodada informada pelo próprio jogo (navegador): serve pro painel até o sorteio ir pro servidor
model Rodada {
  id             Int      @id @default(autoincrement())
  chave          String   @unique // gerada pelo jogo: reenvio não conta duas vezes
  jogo           String
  apostaCentavos Int
  premioCentavos Int
  jogador        String? // e-mail da conta local do site, se logado
  criadoEm       DateTime @default(now())

  @@index([criadoEm])
}

// último saldo informado pelo site pra cada conta (o saldo de verdade ainda mora no aparelho do jogador)
model Jogador {
  email         String   @id // minúsculo
  nome          String
  saldoCentavos Int
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}

// configurações gerais do painel (uma linha só, id = 1)
model Configuracao {
  id            Int       @id @default(1)
  autoBalanco   Boolean   @default(false) // casa negativa na janela → todos os jogos no RTP mínimo até voltar a positivo
  janelaHoras   Int       @default(24)
  metaHoraAtiva Boolean   @default(false) // lucro da última hora abaixo da meta também baixa o RTP
  metaHoraCentavos Int    @default(0)
  saqueExigeDeposito Boolean @default(false) // só saca quem já tem depósito pago no CPF da conta
  saqueMinimoCentavos Int    @default(1000) // R$ 10
  bonusDiarioAtivo Boolean @default(false) // bônus diário liberado no perfil
  bonusDiarioCentavos Int @default(500)
  indicacaoAtiva     Boolean @default(true) // programa "indique e ganhe" ligado
  indicacaoCentavos  Int     @default(500) // quanto o indicador ganha por indicado liberado
  indicacaoMinRodadas Int    @default(1) // rodadas com aposta que o indicado precisa jogar (além de 1 depósito pago)
  infCadastroCentavos Int    @default(100) // influencer: por inscrição feita pelo link dele
  infPrimeiroDepositoCentavos Int @default(500) // influencer: quando o inscrito faz o 1º depósito pago
  infComissaoBp      Int     @default(100) // influencer: % de cada depósito pago dos inscritos, em centésimos de % (100 = 1%)
  infSaqueMinimoCentavos Int @default(1000) // influencer: menor saque
  balancoAtivo  Boolean   @default(false) // RTPs estão baixados agora
  motivoBalanco String? // por que baixou: "janela" | "hora" | "janela+hora"
  rtpsAntes     String? // JSON { jogo: rtp | null } pra restaurar; null = estava no de fábrica
  ativadoEm     DateTime?
  atualizadoPor String?
  atualizadoEm  DateTime  @updatedAt
}

// saque pedido pelo jogador; por enquanto o PIX é feito na mão pelo admin, que aprova ou cancela aqui
model Saque {
  id              String    @id @default(cuid())
  email           String // conta do site (minúsculo)
  nome            String
  cpf             String // só dígitos
  chavePix        String // por enquanto sempre o CPF da própria conta
  valorCentavos   Int
  status          String    @default("pendente") // pendente | aprovado | cancelado
  motivo          String? // por que foi cancelado
  saldoInformado  Int? // saldo (centavos) que o aparelho tinha logo antes do pedido
  decididoPor     String?
  decididoEm      DateTime?
  estornadoEm     DateTime? // cancelado e o valor já voltou pro saldo do jogador (só uma vez)
  criadoEm        DateTime  @default(now())

  @@index([status, criadoEm])
  @@index([email])
}

// bônus que entrou no saldo de um jogador: dinheiro da casa, sai do lucro no dashboard
model Bonus {
  id            Int      @id @default(autoincrement())
  // o mesmo bônus não entra duas vezes: "cadastro:<cpf>", "diario:<email>:<AAAA-MM-DD>" ou "indicacao:<id da indicação>"
  chave         String   @unique
  tipo          String // cadastro | diario | indicacao
  jogador       String // e-mail da conta do site (minúsculo)
  nome          String?
  valorCentavos Int
  criadoEm      DateTime @default(now())

  @@index([criadoEm])
  @@index([jogador])
}

// link de indicação de cada conta do site: https://.../?ref=<codigo>
model Afiliado {
  email    String   @id // minúsculo
  codigo   String   @unique
  nome     String
  cpf      String // só dígitos (barra indicar a si mesmo)
  criadoEm DateTime @default(now())
}

// conta nova criada pelo link de alguém. Libera quando o indicado deposita (1 PIX pago) e joga;
// aí o indicador recebe o valor da configuração, uma vez só (vira Bonus tipo "indicacao")
model Indicacao {
  id            String    @id @default(cuid())
  codigo        String
  indicador     String // e-mail de quem indicou
  indicado      String    @unique // e-mail da conta nova
  indicadoCpf   String    @unique
  indicadoNome  String
  status        String    @default("pendente") // pendente | liberada
  valorCentavos Int? // fixado quando libera (mudar a config depois não mexe no que já liberou)
  liberadaEm    DateTime?
  creditadoEm   DateTime? // já entrou no saldo do indicador
  criadoEm      DateTime  @default(now())

  @@index([indicador])
  @@index([criadoEm])
}

// influencer: parceiro com link próprio (?inf=) e login no painel, onde vê só as comissões dele
model Influencer {
  id       String   @id @default(cuid())
  userId   String   @unique // conta de login (User) criada pelo admin
  codigo   String   @unique
  nome     String
  email    String   @unique // minúsculo, o mesmo do login
  cpf      String // só dígitos (barra o influencer se inscrever no próprio link)
  chavePix String
  ativo    Boolean  @default(true) // desativado: não loga no dashboard e o link para de valer
  criadoPor String
  criadoEm DateTime @default(now())
}

// conta do site criada pelo link de um influencer (uma vez por e-mail e por CPF)
model InfluencerIndicado {
  id           String   @id @default(cuid())
  influencerId String
  email        String   @unique
  cpf          String   @unique
  nome         String
  criadoEm     DateTime @default(now())

  @@index([influencerId, criadoEm])
}

// cada centavo que o influencer ganhou, com o valor de quando foi gerado (mudar a config não mexe no passado)
model InfluencerComissao {
  id           String   @id @default(cuid())
  influencerId String
  chave        String   @unique // "cadastro:<email>" | "primeiro:<email>" | "deposito:<id do depósito>": não duplica
  tipo         String // cadastro | primeiro_deposito | deposito
  indicado     String // e-mail do inscrito que gerou
  depositoId   String?
  baseCentavos Int? // valor do depósito (só no tipo deposito)
  valorCentavos Int
  criadoEm     DateTime @default(now())

  @@index([influencerId, criadoEm])
}

// saque pedido pelo influencer no dashboard dele; o admin paga o PIX na mão e aprova, ou cancela
model InfluencerSaque {
  id            String    @id @default(cuid())
  influencerId  String
  valorCentavos Int
  chavePix      String
  status        String    @default("pendente") // pendente | pago | cancelado
  motivo        String?
  decididoPor   String?
  decididoEm    DateTime?
  criadoEm      DateTime  @default(now())

  @@index([status, criadoEm])
  @@index([influencerId])
}
